[
  {
    "id": "intro",
    "when": {},
    "actions": [
      { "type": "wait", "seconds": 1.5 },
      { "type": "subtitle", "text": "Ngõ 4. Ba năm rồi, vẫn y như cũ.", "duration": 4 },
      { "type": "wait", "seconds": 4.5 },
      { "type": "subtitle", "text": "Nhà bà ở cuối ngõ. Chìa khóa dưới chậu bông trước cửa.", "duration": 4.5 },
      { "type": "objective", "text": "Về nhà bà — cuối ngõ 4" }
    ]
  },
  {
    "id": "shrine",
    "when": { "near": "alleyShrine", "nearRadius": 2.6, "none": ["ending"] },
    "actions": [{ "type": "subtitle", "text": "Miếu thổ địa đầu ngõ. Nhang mới thắp, mà ngõ không một bóng người.", "duration": 4 }]
  },
  {
    "id": "burn_bin",
    "when": { "near": "burnBin", "nearRadius": 2.6, "none": ["ending"] },
    "actions": [{ "type": "subtitle", "text": "Ai đốt vàng mã giữa đêm mưa thế này.", "duration": 3.5 }]
  },
  {
    "id": "neighbor",
    "comment": "Bà Bảy hàng xóm sau cửa cuốn — dạy quy tắc của màn: đừng nhìn vào nhà số 9.",
    "when": { "near": "neighbor", "nearRadius": 3.2, "none": ["ending"] },
    "actions": [
      { "type": "sound", "sound": "whisper", "at": "neighbor" },
      { "type": "subtitle", "text": "“Út hả con? Về chịu tang bà hả…”", "duration": 3.5, "voice": true },
      { "type": "wait", "seconds": 4 },
      { "type": "subtitle", "text": "“Đi thẳng về nhà nghe con. Ngang nhà số 9 thì đừng có ngước lên nhìn.”", "duration": 5, "voice": true },
      { "type": "wait", "seconds": 5.5 },
      { "type": "subtitle", "text": "“Nhà đó tắt đèn từ đêm bà con mất. Ai nhìn vô… là nó nhìn lại.”", "duration": 5, "voice": true },
      { "type": "setFlag", "flag": "warned" },
      { "type": "objective", "text": "Về nhà bà. Đừng nhìn lên cửa sổ nhà số 9" }
    ]
  },
  {
    "id": "dark_house_pass",
    "comment": "Đi ngang nhà số 9: có tiếng va trong nhà — cám dỗ ngước lên nhìn.",
    "when": { "near": "darkHouse", "nearRadius": 3.4, "none": ["stared", "ending"] },
    "actions": [
      { "type": "wait", "seconds": 0.8 },
      { "type": "sound", "sound": "knock", "at": "darkHouse" },
      { "type": "wait", "seconds": 1.2 },
      { "type": "subtitle", "text": "…Trên tầng hai nhà số 9 có tiếng gì vừa đập vào cửa kính.", "duration": 4 }
    ]
  },
  {
    "id": "stared",
    "comment": "Vi phạm quy tắc của màn: nhìn thẳng lên cửa sổ tối. Gương mặt hiện ra, đèn ngõ tắt dần, nó đuổi theo.",
    "when": { "look": "darkWindow", "none": ["stared", "ending", "entered_house"] },
    "actions": [
      { "type": "setFlag", "flag": "stared" },
      { "type": "show", "target": "darkFace", "visible": true },
      { "type": "sound", "sound": "sting" },
      { "type": "tension", "add": 0.4 },
      { "type": "wait", "seconds": 0.9 },
      { "type": "show", "target": "darkFace", "visible": false },
      { "type": "lights", "state": "flicker" },
      { "type": "wait", "seconds": 1.6 },
      { "type": "lights", "state": "off" },
      { "type": "subtitle", "text": "“Út… nhìn thấy bà rồi hả?”", "duration": 3, "voice": true, "glitch": "“Út… nhìn thấy TAO rồi hả?”" },
      { "type": "wait", "seconds": 2 },
      { "type": "sound", "sound": "heavyStep", "at": "alleyBehind" },
      { "type": "objective", "text": "Chạy về nhà. Lật chậu bông lấy chìa khóa", "glitch": "Quay lại đi Út" },
      { "type": "wait", "seconds": 1.5 },
      { "type": "entity", "do": "alert", "at": "alleyBehind" },
      { "type": "setFlag", "flag": "hunting" }
    ]
  },
  {
    "id": "gate",
    "comment": "Tới cửa nhà bà: năm đôi dép. Nếu chưa phạm quy tắc thì bóng người lóe ở giữa ngõ khi đèn chập chờn.",
    "when": { "near": "gate", "nearRadius": 3, "none": ["ending"] },
    "actions": [
      { "type": "subtitle", "text": "Trước cửa nhà bà có năm đôi dép. Nhà mình chỉ còn bốn người.", "duration": 4.5 },
      { "type": "objective", "text": "Lật chậu bông lấy chìa khóa, vào nhà" }
    ]
  },
  {
    "id": "gate_glimpse",
    "when": { "all": ["has_door_key"], "none": ["stared", "ending", "entered_house"], "delay": 1.2 },
    "actions": [
      { "type": "lights", "state": "flicker" },
      { "type": "entity", "do": "appear", "at": "alleyMid" },
      { "type": "sound", "sound": "heavyStep", "at": "alleyMid" },
      { "type": "wait", "seconds": 1.4 },
      { "type": "entity", "do": "vanish" },
      { "type": "subtitle", "text": "…Giữa ngõ vừa có ai đứng nhìn theo.", "duration": 3.5 }
    ]
  },
  {
    "id": "ending_home",
    "when": { "all": ["entered_house"], "none": ["caught"] },
    "actions": [
      { "type": "setFlag", "flag": "ending" },
      { "type": "entity", "do": "vanish" },
      { "type": "subtitle", "text": "Cánh cửa khép lại sau lưng.", "duration": 3 },
      { "type": "wait", "seconds": 3.5 },
      { "type": "ending", "title": "Về tới nhà", "text": "Ngoài ngõ, tiếng mưa át hết mọi tiếng khác.\nTrừ một tiếng gõ rất khẽ — ba lần — vào cánh cửa mình vừa đóng.", "next": 1 }
    ]
  },
  {
    "id": "ending_caught",
    "when": { "all": ["caught"], "none": ["ending"] },
    "actions": [
      { "type": "setFlag", "flag": "ending" },
      { "type": "wait", "seconds": 1.1 },
      { "type": "lights", "state": "blackout" },
      { "type": "entity", "do": "vanish" },
      { "type": "wait", "seconds": 1.2 },
      { "type": "ending", "title": "Bạn đã nhìn lại.", "text": "Sáng hôm sau, người trong ngõ thấy trước cửa nhà bà có thêm một đôi dép.\nThành sáu đôi." }
    ]
  }
]
