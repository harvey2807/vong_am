      { "type": "wait", "seconds": 1.5 },
      { "type": "subtitle", "text": "Đầu làng. Trời vừa sập tối mà đồng đã đen kịt.", "duration": 4 },
      { "type": "wait", "seconds": 4.5 },
      { "type": "subtitle", "text": "Cuối bờ ruộng kia là gốc đa — có ngọn đèn đỏ dưới gốc.", "duration": 4 },
      { "type": "objective", "text": "Ra gốc đa đầu làng tìm chú Tư — đi theo bờ ruộng" }
