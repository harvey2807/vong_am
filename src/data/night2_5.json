    "actions": [
      { "type": "subtitle", "text": "Tấm bìa ai treo trên cọc tre: “ĐÊM QUA ĐỒNG PHẢI TẮT ĐÈN”.", "duration": 4.5 },
      { "type": "wait", "seconds": 5 },
      { "type": "subtitle", "text": "Hồi nhỏ bà hay dọa: đèn soi tới đâu, bù nhìn thức tới đó.", "duration": 4.5 },
      { "type": "setFlag", "flag": "field_rule" },
      { "type": "objective", "text": "Ra gốc đa. Qua đồng thì tắt đèn pin (F) — đi theo đom đóm" }
    ]
  },
  {
