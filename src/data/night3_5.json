[
  {
    "id": "intro",
    "comment": "Hồi tưởng — Út sáu tuổi, đêm Rằm tháng Bảy năm Quý Mùi (2003). Bước chân không có tiếng gót, chỉ có tiếng giấy (House.past).",
    "when": {},
    "actions": [
      { "type": "wait", "seconds": 1.5 },
      { "type": "subtitle", "text": "Rằm tháng Bảy, năm Quý Mùi. Mình sáu tuổi.", "duration": 4 },
      { "type": "wait", "seconds": 4.5 },
      { "type": "subtitle", "text": "Nhà còn thơm mùi hồ dán với mùi gỗ mới. Trong tiệm có tiếng bào gỗ.", "duration": 4.5 },
      { "type": "wait", "seconds": 5 },
      { "type": "objective", "text": "Đi tìm ông trong tiệm", "hints": ["Tiệm Phúc Ký ở phía bên phải hành lang, cửa đang mở.", "Ông ngồi ở bàn làm việc sát tường trong cùng của tiệm."] }
    ]
  },
  {
    "id": "meet_ong",
    "comment": "Ông bào cỗ hòm nhỏ \"cho con búp bê\" — cỗ hòm sau này nằm dưới gầm bàn thờ.",
