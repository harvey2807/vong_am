      { "type": "subtitle", "text": "Ông ngồi quay lưng ra cửa, đang bào một cái hòm nhỏ xíu.", "duration": 4 },
      { "type": "wait", "seconds": 4.5 },
      { "type": "subtitle", "text": "“Ông đóng cái rương cho ai vậy ông?”", "duration": 3.5 },
      { "type": "wait", "seconds": 4 },
      { "type": "sound", "sound": "whisper", "at": "shopBench" },
      { "type": "subtitle", "text": "“Cho con búp bê.”", "duration": 3, "voice": true },
      { "type": "wait", "seconds": 3.5 },
      { "type": "sound", "sound": "whisper", "at": "shopBench" },
      { "type": "subtitle", "text": "“Út ra ngoài chơi đi con. Đừng lại gần con hình nhân trùm khăn đỏ nghe.”", "duration": 5, "voice": true },
      { "type": "wait", "seconds": 5.5 },
      { "type": "objective", "text": "Ra phòng khách với bà", "hints": ["Phòng khách ở cuối hành lang, cùng phía với tiệm.", "Bàn thờ áp vào bức tường trong cùng phòng khách."] }
    ]
  },
  {
